index 0000000..1927331
--- /dev/null
+++ b/src/opencloud/ocMode.ts
@@ -0,0 +1,402 @@
+// src/opencloud/ocMode.ts
+//
+// OpenCloud mode: TeXlyre runs in a same-origin iframe of the OpenCloud web
+// extension "texlyre". The parent window provides `__texlyreOpenCloud`, a
+// small file bridge onto the OpenCloud folder of the opened document
+// (WebDAV on the OpenCloud side).
+//
+// TeXlyre's workspace mode ("link a project to a local folder") talks to the
+// folder only through FileSystemDirectoryHandle. OcDirectoryHandle implements
+// the part of that interface TeXlyre uses on top of the bridge, so the
+// project is imported from, written back to and reconciled with the
+// OpenCloud folder by TeXlyre's own workspace logic.
+
+export interface OcBridgeEntry {
+	name: string;
+	isDirectory: boolean;
+	size: number;
+	lastModified: number;
+	/** Changes with every write (WebDAV ETag); mtimes only have seconds */
+	etag?: string;
+}
+
+export interface OcBridge {
+	version: 1;
+	/** Stable key of the OpenCloud folder (space + path) */
+	folderKey: string;
+	/** Display name of the folder, used as project name */
+	folderName: string;
+	/** Path of the opened document relative to the folder, e.g. "main.typ" */
+	openFile: string;
+	projectType: 'typst' | 'latex';
+	readOnly: boolean;
+	/** OpenCloud user id, keeps TeXlyre accounts apart in a shared browser */
+	userId: string;
+	userName: string;
+	list(path: string): Promise<OcBridgeEntry[]>;
+	read(path: string): Promise<ArrayBuffer>;
+	write(path: string, data: ArrayBuffer): Promise<void>;
+	mkdir(path: string): Promise<void>;
+	remove(path: string): Promise<void>;
+	/** Called once the editor shows the document */
+	ready?(): void;
+}
+
+declare global {
+	interface Window {
+		__texlyreOpenCloud?: OcBridge;
+	}
+}
+
+let cachedBridge: OcBridge | null | undefined;
+
+export function getOcBridge(): OcBridge | null {
+	if (cachedBridge !== undefined) return cachedBridge;
+	cachedBridge = null;
+	try {
+		if (window.parent !== window && window.parent.__texlyreOpenCloud?.version === 1) {
+			cachedBridge = window.parent.__texlyreOpenCloud;
+		}
+	} catch {
+		// cross-origin parent: not OpenCloud
+	}
+	return cachedBridge;
+}
+
+export function isOcMode(): boolean {
+	return getOcBridge() !== null;
+}
+
+const join = (dir: string, name: string) => (dir ? `${dir}/${name}` : name);
+
+const notFound = (path: string) =>
+	new DOMException(`${path} not found`, 'NotFoundError');
+
+// Always granted: TeXlyre refuses to link or restore a folder without write
+// permission, read-only OpenCloud folders are still opened - writes fail.
+const permission = (_bridge: OcBridge, _mode?: string): PermissionState => 'granted';
+
+/**
+ * Directory listings are reused for a moment: TeXlyre stats every file
+ * through getFileHandle()/getFile(), one PROPFIND per directory is enough.
+ */
+const LIST_TTL_MS = 1500;
+const listings = new Map<string, { at: number; entries: Promise<OcBridgeEntry[]> }>();
+/** File contents by path, valid while size and mtime match the listing */
+const contents = new Map<string, { version: string; data: ArrayBuffer }>();
+
+const versionOf = (entry: OcBridgeEntry) =>
+	`${entry.etag ?? ''}|${entry.size}|${entry.lastModified}`;
+
+function list(bridge: OcBridge, path: string): Promise<OcBridgeEntry[]> {
+	const cached = listings.get(path);
+	if (cached && Date.now() - cached.at < LIST_TTL_MS) return cached.entries;
+	const entries = bridge.list(path);
+	listings.set(path, { at: Date.now(), entries });
+	entries.catch(() => listings.delete(path));
+	return entries;
+}
+
+function invalidate(path: string): void {
+	const dir = path.includes('/') ? path.slice(0, path.lastIndexOf('/')) : '';
+	listings.delete(dir);
+	listings.delete(path);
+}
+
+async function entryOf(bridge: OcBridge, dir: string, name: string): Promise<OcBridgeEntry | undefined> {
+	return (await list(bridge, dir)).find((entry) => entry.name === name);
+}
+
+class OcWritable {
+	private chunks: BlobPart[] = [];
+
+	constructor(
+		private readonly bridge: OcBridge,
+		private readonly path: string,
+	) {}
+
+	async write(data: BufferSource | Blob | string | { type: string; data?: unknown }): Promise<void> {
+		if (data && typeof data === 'object' && 'type' in data && !(data instanceof Blob)) {
+			if (data.type === 'write' && data.data !== undefined) {
+				this.chunks.push(data.data as BlobPart);
+			}
+			return;
+		}
+		this.chunks.push(data as BlobPart);
+	}
+
+	async close(): Promise<void> {
+		const buffer = await new Blob(this.chunks).arrayBuffer();
+		await this.bridge.write(this.path, buffer);
+		contents.delete(this.path);
+		invalidate(this.path);
+	}
+
+	async abort(): Promise<void> {
+		this.chunks = [];
+	}
+}
+
+export class OcFileHandle {
+	readonly kind = 'file' as const;
+
+	constructor(
+		private readonly bridge: OcBridge,
+		readonly path: string,
+		readonly name: string,
+	) {}
+
+	async getFile(): Promise<File> {
+		const dir = this.path.includes('/') ? this.path.slice(0, this.path.lastIndexOf('/')) : '';
+		const entry = await entryOf(this.bridge, dir, this.name);
+		if (!entry || entry.isDirectory) throw notFound(this.path);
+		const cached = contents.get(this.path);
+		let data: ArrayBuffer;
+		if (cached && cached.version === versionOf(entry)) {
+			data = cached.data;
+		} else {
+			data = await this.bridge.read(this.path);
+			contents.set(this.path, { version: versionOf(entry), data });
+		}
+		return new File([data], this.name, { lastModified: entry.lastModified });
+	}
+
+	async createWritable(): Promise<OcWritable> {
+		if (this.bridge.readOnly) {
+			throw new DOMException('read-only', 'NotAllowedError');
+		}
+		return new OcWritable(this.bridge, this.path);
+	}
+
+	async queryPermission(options?: { mode?: string }): Promise<PermissionState> {
+		return permission(this.bridge, options?.mode);
+	}
+
+	async requestPermission(options?: { mode?: string }): Promise<PermissionState> {
+		return permission(this.bridge, options?.mode);
+	}
+
+	async isSameEntry(other: { path?: string; kind?: string }): Promise<boolean> {
+		return other?.kind === this.kind && other.path === this.path;
+	}
+}
+
+export class OcDirectoryHandle {
+	readonly kind = 'directory' as const;
+	/** Marker for DiskHandleStore: stored as a plain descriptor, not cloned */
+	readonly __ocHandle = true;
+
+	constructor(
+		private readonly bridge: OcBridge,
+		readonly path: string,
+		readonly name: string = bridge.folderName,
+	) {}
+
+	async getFileHandle(name: string, options?: { create?: boolean }): Promise<OcFileHandle> {
+		const path = join(this.path, name);
+		const entry = await entryOf(this.bridge, this.path, name);
+		if (entry?.isDirectory) {
+			throw new DOMException(`${path} is a directory`, 'TypeMismatchError');
+		}
+		if (!entry) {
+			if (!options?.create) throw notFound(path);
+			await this.bridge.write(path, new ArrayBuffer(0));
+			invalidate(path);
+		}
+		return new OcFileHandle(this.bridge, path, name);
+	}
+
+	async getDirectoryHandle(name: string, options?: { create?: boolean }): Promise<OcDirectoryHandle> {
+		const path = join(this.path, name);
+		const entry = await entryOf(this.bridge, this.path, name);
+		if (entry && !entry.isDirectory) {
+			throw new DOMException(`${path} is a file`, 'TypeMismatchError');
+		}
+		if (!entry) {
+			if (!options?.create) throw notFound(path);
+			await this.bridge.mkdir(path);
+			invalidate(path);
+		}
+		return new OcDirectoryHandle(this.bridge, path, name);
+	}
+
+	async removeEntry(name: string): Promise<void> {
+		const path = join(this.path, name);
+		await this.bridge.remove(path);
+		contents.delete(path);
+		invalidate(path);
+	}
+
+	async *entries(): AsyncGenerator<[string, OcFileHandle | OcDirectoryHandle]> {
+		for (const entry of await list(this.bridge, this.path)) {
+			const path = join(this.path, entry.name);
+			yield [
+				entry.name,
+				entry.isDirectory
+					? new OcDirectoryHandle(this.bridge, path, entry.name)
+					: new OcFileHandle(this.bridge, path, entry.name),
+			];
+		}
+	}
+
+	async *values(): AsyncGenerator<OcFileHandle | OcDirectoryHandle> {
+		for await (const [, handle] of this.entries()) yield handle;
+	}
+
+	async *keys(): AsyncGenerator<string> {
+		for await (const [name] of this.entries()) yield name;
+	}
+
+	[Symbol.asyncIterator]() {
+		return this.entries();
+	}
+
+	async queryPermission(options?: { mode?: string }): Promise<PermissionState> {
+		return permission(this.bridge, options?.mode);
+	}
+
+	async requestPermission(options?: { mode?: string }): Promise<PermissionState> {
+		return permission(this.bridge, options?.mode);
+	}
+
+	async isSameEntry(other: { path?: string; kind?: string }): Promise<boolean> {
+		return other?.kind === this.kind && other.path === this.path;
+	}
+
+	async resolve(): Promise<string[] | null> {
+		return null;
+	}
+}
+
+/** DiskHandleStore: OpenCloud handles are persisted as descriptors. */
+export interface OcHandleDescriptor {
+	__ocFolderKey: string;
+	path: string;
+}
+
+export function toStoredHandle<T>(handle: T): T | OcHandleDescriptor {
+	const bridge = getOcBridge();
+	if (bridge && handle && (handle as { __ocHandle?: boolean }).__ocHandle) {
+		return { __ocFolderKey: bridge.folderKey, path: (handle as unknown as OcDirectoryHandle).path };
+	}
+	return handle;
+}
+
+export function fromStoredHandle<T>(stored: T | OcHandleDescriptor | null): T | null {
+	if (stored && typeof stored === 'object' && '__ocFolderKey' in stored) {
+		const bridge = getOcBridge();
+		// a descriptor of another OpenCloud folder is not usable here
+		if (!bridge || bridge.folderKey !== stored.__ocFolderKey) return null;
+		return new OcDirectoryHandle(bridge, stored.path) as unknown as T;
+	}
+	return stored as T | null;
+}
+
+// ---- collaboration ----------------------------------------------------------
+
+/**
+ * WebRTC options in OpenCloud mode: no signaling servers at all. The documents
+ * live in OpenCloud; TeXlyre's peer-to-peer collaboration (signaling on
+ * texlyre.org) has no shared document state there and the OpenCloud CSP blocks
+ * it anyway. null outside OpenCloud mode.
+ */
+export function ocWebrtcOptions(): { signaling: string[] } | null {
+	return getOcBridge() ? { signaling: [] } : null;
+}
+
+// ---- account and project ----------------------------------------------------
+
+const ACCOUNTS_KEY = 'texlyre-oc-accounts';
+const PROJECTS_KEY = 'texlyre-oc-projects';
+
+function readJson<T>(key: string): T {
+	try {
+		return JSON.parse(localStorage.getItem(key) ?? '{}') as T;
+	} catch {
+		return {} as T;
+	}
+}
+
+function randomSecret(): string {
+	const bytes = crypto.getRandomValues(new Uint8Array(24));
+	return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
+}
+
+interface AccountApi {
+	login(username: string, password: string): Promise<unknown>;
+	register(username: string, password: string): Promise<unknown>;
+}
+
+/**
+ * One local TeXlyre account per OpenCloud user, created and signed in
+ * automatically. The password never leaves this browser; the documents
+ * themselves live in OpenCloud.
+ */
+export async function ocSignIn(auth: AccountApi): Promise<void> {
+	const bridge = getOcBridge();
+	if (!bridge) return;
+	const accounts = readJson<Record<string, { username: string; password: string }>>(ACCOUNTS_KEY);
+	const known = accounts[bridge.userId];
+	if (known) {
+		try {
+			await auth.login(known.username, known.password);
+			return;
+		} catch {
+			// account was removed from TeXlyre's database - create a new one
+		}
+	}
+	const base = `opencloud-${(bridge.userName || bridge.userId).replace(/[^\w.-]/g, '_')}`;
+	const password = randomSecret();
+	let username = base;
+	for (let attempt = 1; ; attempt++) {
+		try {
+			await auth.register(username, password);
+			break;
+		} catch (error) {
+			if (attempt >= 5) throw error;
+			username = `${base}-${attempt}`;
+		}
+	}
+	accounts[bridge.userId] = { username, password };
+	localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(accounts));
+}
+
+interface ProjectApi {
+	getProjects(): Promise<Array<{ id: string; docUrl: string }>>;
+	createProject(input: {
+		name: string;
+		description: string;
+		type: string;
+		tags: string[];
+		isFavorite: boolean;
+	}): Promise<{ id: string; docUrl: string }>;
+	link(projectId: string, handle: OcDirectoryHandle): Promise<void>;
+}
+
+/**
+ * Project of the OpenCloud folder: reused when it still exists, otherwise
+ * created and linked to the folder (TeXlyre imports it on open). Returns the
+ * location hash that opens the document and compiles it.
+ */
+export async function ocOpenProject(api: ProjectApi): Promise<string> {
+	const bridge = getOcBridge();
+	if (!bridge) throw new Error('not in OpenCloud mode');
+	const mapping = readJson<Record<string, string>>(PROJECTS_KEY);
+	const mappingKey = `${bridge.userId}|${bridge.folderKey}`;
+	const projects = await api.getProjects();
+	let project = projects.find((p) => p.docUrl === mapping[mappingKey]);
+	if (!project) {
+		project = await api.createProject({
+			name: bridge.folderName,
+			description: 'OpenCloud',
+			type: bridge.projectType,
+			tags: ['opencloud'],
+			isFavorite: false,
+		});
+		await api.link(project.id, new OcDirectoryHandle(bridge, ''));
+		mapping[mappingKey] = project.docUrl;
+		localStorage.setItem(PROJECTS_KEY, JSON.stringify(mapping));
+	}
+	const file = `/${bridge.openFile.replace(/^\/+/, '')}`;
+	return `${project.docUrl}&file:${encodeURIComponent(file)}&compile:${bridge.projectType}`;
+}
