{
  "name": "@protronic/flowberry",
  "version": "0.2.0",
  "description": "OpenCloud web extension: Ablaufplan-Editor (PAP) für einfache SPS-Steuerungen, generiert Berry-Script (.be)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check:types": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "pnpm run build && pnpm run check:types",
    "test": "tsx --test test/*.test.ts",
    "harness": "vite --config vite.harness.config.ts"
  },
  "keywords": [
    "opencloud",
    "vue-flow",
    "berry",
    "flowchart",
    "plc"
  ],
  "license": "MIT",
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@opencloud-eu/extension-sdk": "8.1.0",
    "@opencloud-eu/tsconfig": "^7.0.0",
    "@opencloud-eu/web-client": "8.1.0",
    "@opencloud-eu/web-pkg": "8.1.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "packageManager": "pnpm@10.33.3"
}
