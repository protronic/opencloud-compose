{
  "name": "@protronic/flowberry",
  "version": "0.1.0",
  "description": "OpenCloud web extension: reduzierter bpmn-js-Editor für Verknüpfungslogik, generiert Berry-Script (.be)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check:types": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "pnpm run build && pnpm run check:types"
  },
  "keywords": [
    "opencloud",
    "bpmn-js",
    "berry",
    "ladder-logic"
  ],
  "license": "MIT",
  "dependencies": {
    "bpmn-js": "^18.6.3",
    "diagram-js": "^15.26.0",
    "diagram-js-minimap": "^5.3.0",
    "tiny-svg": "^4.1.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@opencloud-eu/extension-sdk": "7.1.2",
    "@opencloud-eu/tsconfig": "^7.0.0",
    "@opencloud-eu/web-client": "7.0.0",
    "@opencloud-eu/web-pkg": "7.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "packageManager": "pnpm@10.33.3"
}
