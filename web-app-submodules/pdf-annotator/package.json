{
  "name": "@protronic/pdf-annotator",
  "version": "1.0.0",
  "description": "OpenCloud web extension that views and annotates PDFs with pdf.js and saves them back to OpenCloud storage",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "check:types": "vue-tsc --noEmit -p tsconfig.app.json",
    "check": "pnpm run build && pnpm run check:types"
  },
  "keywords": [
    "opencloud",
    "pdf",
    "pdfjs",
    "annotations"
  ],
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "^5.4.149",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@opencloud-eu/extension-sdk": "7.1.2",
    "@opencloud-eu/tsconfig": "^7.0.0",
    "@opencloud-eu/web-client": "7.0.0",
    "@opencloud-eu/web-pkg": "7.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "packageManager": "pnpm@10.33.3"
}
